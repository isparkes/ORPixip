<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging configuration for the Pixip revenue assurance application.

  OpenRate asks for loggers by name: "Framework", "ErrorLog" and "Statistics"
  come from the framework itself, and each pipeline logs under its own name as
  declared in Pixip.properties.xml.
-->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>

    <File name="FrameworkAppender" fileName="log/PixipFramework.log">
      <PatternLayout>
        <pattern>%d %p %C{1.} [%t] %m%n</pattern>
      </PatternLayout>
    </File>

    <File name="ErrorAppender" fileName="log/Error.log">
      <PatternLayout>
        <pattern>%d %p %C{1.} [%t] %m%n</pattern>
      </PatternLayout>
    </File>

    <File name="StatisticsAppender" fileName="log/PixipStatistics.log">
      <PatternLayout>
        <pattern>%d %p %C{1.} [%t] %m%n</pattern>
      </PatternLayout>
    </File>

    <File name="PixipPipeAppender" fileName="log/PixipPipe.log">
      <PatternLayout>
        <pattern>%d %p %C{1.} [%t] %m%n</pattern>
      </PatternLayout>
    </File>

    <File name="XMASSAppender" fileName="log/XMASSPipes.log">
      <PatternLayout>
        <pattern>%d %p %C{1.} [%t] %m%n</pattern>
      </PatternLayout>
    </File>
  </Appenders>

  <Loggers>
    <Logger name="Framework" level="info" additivity="false">
      <AppenderRef ref="FrameworkAppender"/>
    </Logger>

    <Logger name="ErrorLog" level="debug" additivity="false">
      <AppenderRef ref="ErrorAppender"/>
    </Logger>

    <Logger name="Statistics" level="info" additivity="false">
      <AppenderRef ref="StatisticsAppender"/>
    </Logger>

    <Logger name="PixipPipe" level="info" additivity="false">
      <AppenderRef ref="PixipPipeAppender"/>
    </Logger>

    <!-- The four probe pipelines share one log: they do the same work on
         different record types, and reading them interleaved is easier than
         following four files. -->
    <Logger name="XMASSCallPipe" level="info" additivity="false">
      <AppenderRef ref="XMASSAppender"/>
    </Logger>

    <Logger name="XMASSFtpPipe" level="info" additivity="false">
      <AppenderRef ref="XMASSAppender"/>
    </Logger>

    <Logger name="XMASSHttpPipe" level="info" additivity="false">
      <AppenderRef ref="XMASSAppender"/>
    </Logger>

    <Logger name="XMASSSmsPipe" level="info" additivity="false">
      <AppenderRef ref="XMASSAppender"/>
    </Logger>

    <Logger name="Pixip" level="info" additivity="false">
      <AppenderRef ref="FrameworkAppender"/>
    </Logger>

    <Root level="error">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
